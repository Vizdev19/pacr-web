{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": false },
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/social", "destination": "/download?via=social", "permanent": true },
    { "source": "/downloads", "destination": "/download?via=downloads", "permanent": true }
  ],
  "rewrites": [
    { "source": "/s/:slug/photo", "destination": "/api/squad?slug=:slug&photo=1" },
    { "source": "/s/:slug/cover", "destination": "/api/squad?slug=:slug&cover=1" },
    { "source": "/s/:slug/card", "destination": "/api/squad?slug=:slug&card=1" },
    { "source": "/s/:slug", "destination": "/api/squad?slug=:slug" },
    { "source": "/u/:handle/photo", "destination": "/api/profile?handle=:handle&photo=1" },
    { "source": "/u/:handle", "destination": "/api/profile?handle=:handle" },
    { "source": "/p/:ref/photo", "destination": "/api/post?ref=:ref&part=photo" },
    { "source": "/p/:ref/avatar", "destination": "/api/post?ref=:ref&part=avatar" },
    { "source": "/p/:ref", "destination": "/api/post?ref=:ref" },
    { "source": "/e/:ref/poster", "destination": "/api/event?ref=:ref&part=poster" },
    { "source": "/e/:ref", "destination": "/api/event?ref=:ref" },
    { "source": "/host/new", "destination": "/host-events" },
    { "source": "/host/apply", "destination": "/host-events" },
    { "source": "/host/e/:path*", "destination": "/host-events" },
    { "source": "/host", "destination": "https://pacr-host.vercel.app/host" },
    { "source": "/host/:path*", "destination": "https://pacr-host.vercel.app/host/:path*" }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ]
}
